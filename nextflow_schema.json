{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/laynez-21/repexprep/nextflow_schema.json",
  "title": "laynez-21-repexprep pipeline parameters",
  "description": "Schema for WGS preprocessing for RepeatExplorer2.",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "format": "file-path",
          "description": "Path to the input samplesheet."
        },
        "outdir": {
          "type": "string",
          "format": "directory-path",
          "default": "results",
          "description": "Directory in which pipeline outputs are published."
        },
        "test_mode": {
          "type": "boolean",
          "default": false,
          "description": "Enable development test mode."
        },
        "publish_dir_mode": {
          "type": "string",
          "default": "copy",
          "enum": [
            "copy",
            "copyNoFollow",
            "link",
            "rellink",
            "symlink"
          ],
          "description": "Method used to publish pipeline outputs."
        }
      },
      "required": [
        "input"
      ]
    },
    "sampling_and_filtering_options": {
      "title": "Sampling and filtering options",
      "type": "object",
      "properties": {
        "genome_size_bp": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Deprecated compatibility alias for genome_size_1C_bp."
        },
        "target_coverage": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "exclusiveMinimum": 0,
          "description": "Optional global target-coverage fallback. Per-sample values may be supplied through the samplesheet."
        },
        "sampling_seed": {
          "type": "integer",
          "default": 42,
          "minimum": 0,
          "description": "Random seed used for reproducible read subsampling."
        },
        "skip_organelle_filter": {
          "type": "boolean",
          "default": false,
          "description": "Skip organelle-read filtering."
        },
        "target_length_mode": {
          "type": "string",
          "enum": [
            "global_auto",
            "global_fixed"
          ],
          "default": "global_auto",
          "description": "Strategy used to select the read length applied before RepeatExplorer export."
        },
        "target_read_length": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Dataset-wide target read length. Required when target_length_mode is global_fixed."
        },
        "min_retained_fraction": {
          "type": "number",
          "default": 0.95,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Minimum desired fraction of complete read pairs retained when automatically selecting a target length."
        },
        "min_target_read_length": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Minimum acceptable automatically selected target read length."
        },
        "max_target_read_length": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "description": "Maximum acceptable target read length."
        },
        "genome_size_1C_bp": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "Optional global haploid 1C genome-size fallback in base pairs. Per-sample values may be supplied through the samplesheet."
        },
        "coverage_basis": {
          "type": "string",
          "default": "haploid_1C",
          "enum": [
            "haploid_1C"
          ],
          "description": "Coverage is calculated relative to the haploid 1C genome size."
        }
      }
    },
    "repeatexplorer_options": {
      "title": "RepeatExplorer options",
      "type": "object",
      "properties": {
        "run_repeatexplorer": {
          "type": "boolean",
          "default": false,
          "description": "Run RepeatExplorer independently for each validated sample FASTA."
        },
        "repeatexplorer_taxon": {
          "type": "string",
          "default": "VIRIDIPLANTAE3.0",
          "minLength": 1,
          "description": "RepeatExplorer taxonomic database or classification preset."
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/input_output_options"
    },
    {
      "$ref": "#/definitions/sampling_and_filtering_options"
    },
    {
      "$ref": "#/definitions/repeatexplorer_options"
    },
    {
      "if": {
        "properties": {
          "target_length_mode": {
            "const": "global_fixed"
          }
        },
        "required": [
          "target_length_mode"
        ]
      },
      "then": {
        "properties": {
          "target_read_length": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "target_read_length"
        ]
      }
    }
  ]
}
