process {
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/raw_qc/fastqc" },
            mode: 'copy'
        ]
    }
    withName: 'RAW_FASTQ_STATS' {
        publishDir = [
            path: { "${params.outdir}/raw_qc/fastq_stats" },
            mode: 'copy'
        ]
    }
    withName: 'SEQKIT_STATS' {
        publishDir = [
            path: { "${params.outdir}/raw_qc/seqkit_stats" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
