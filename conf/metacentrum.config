/*
 * conf/metacentrum.config
 *
 * Preliminary profile for MetaCentrum execution.
 */

process {
    executor = 'pbspro'
    withName: ORGANELLE_FILTER {
        cpus   = 8
        memory = '16 GB'
        time   = '12h'
    }
}

executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
}

profiles {
    metacentrum {
        process {
            withName: 'REPEATEXPLORER' {
                cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
                memory = { check_max( 64.GB * task.attempt, 'memory' ) }
                time   = { check_max( 24.h * task.attempt, 'time' ) }
            }
        }
    }
}