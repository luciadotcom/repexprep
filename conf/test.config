/*
 * conf/test.config
 *
 * Perfil local de prueba.
 * Debe ser pequeño, rápido y seguro.
 */

params {
    input     = 'assets/samplesheet.test.csv'
    outdir    = 'results/test'
    test_mode = true
}

process {
    executor = 'local'

    withLabel: process_low {
        cpus = 1
        memory = '1 GB'
        time = '1h'
    }
}